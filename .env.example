# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# RPC endpoints. Use Alchemy/Infura rather than the public RPC:
# the public rpc-amoy.polygon.technology is rate-limited and unreliable.
AMOY_RPC_URL="https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY"
POLYGON_RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY"

# Relayer signing key. MUST be a dedicated burner wallet funded with a small
# amount only — it sits behind a public, unauthenticated endpoint.
RELAYER_PRIVATE_KEY="0x..."

# Deployed contract addresses (filled in after deploy)
NEXT_PUBLIC_CONTRACT_AMOY=""
NEXT_PUBLIC_CONTRACT_POLYGON=""

# Bonus B: set to "true" once a mainnet contract is deployed and funded
NEXT_PUBLIC_MAINNET_ENABLED="false"

# Optional: for `hardhat verify` on PolygonScan
POLYGONSCAN_API_KEY=""
