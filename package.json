{
  "name": "edi-badge-minter",
  "version": "1.0.0",
  "private": true,
  "description": "ELCA EDI Challenge 2026 - public on-chain badge minter on Polygon Amoy",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
